# Copy this file to `.env` and fill in your values.
# .env is gitignored — never commit real keys.
#
# Loaded automatically by examples/common.py's load_user_wallet() helper.

# Invitation code for registration (Mainnet and Devnet) — request one from the Upside team.
UPSIDE_INVITE_CODE=

# Your account private key (64-hex, with or without 0x prefix).
# Generate one via: python3 examples/01_register.py
# Keep this file local (it is gitignored, mode 600). On Mainnet this key controls real funds.
USER_PRIVATE_KEY=

# Your accountId (integer). Set after registering.
# Also findable by re-running 01_register.py — it will 409 and print the aid.
USER_ACCOUNT_ID=

# Environment (optional). Default: Mainnet https://upsidemax.xyz (chainId 9788).
# For Devnet (chainId 9767):
# UPSIDE_BASE_URL=https://dev.upsidemax.xyz
# The WebSocket URL and chainId follow UPSIDE_BASE_URL; set them only for another address:
# UPSIDE_WS_URL=wss://dev.upsidemax.xyz/ws
# UPSIDE_CHAIN_ID=9767
