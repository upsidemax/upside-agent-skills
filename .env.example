# Copy this file to `.env` and fill in your values.
# .env is gitignored — never commit real keys.
#
# Loaded automatically by examples/common.py's load_user_wallet() helper.

# Invite code for QA registration — request one from the Upside team.
UPSIDE_INVITE_CODE=

# Your account private key (64-hex, with or without 0x prefix).
# Generate one via: python3 examples/01_register.py
# QA is test-only — keys are fine to save locally in plain text.
USER_PRIVATE_KEY=

# Your accountId (integer). Set after registering.
# Also findable by re-running 01_register.py — it will 409 and print the aid.
USER_ACCOUNT_ID=

# Override the default QA endpoint (optional).
# UPSIDE_BASE_URL=https://dev.upsidemax.xyz
# UPSIDE_WS_URL=wss://dev.upsidemax.xyz/ws
